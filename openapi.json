{
  "components": {
    "schemas": {
      "CurrentUser": {
        "description": "Authenticated user context used for navigation and access decisions.",
        "properties": {
          "actions": {
            "description": "Alias for permissions.",
            "items": {
              "type": "string"
            },
            "title": "Actions",
            "type": "array"
          },
          "category_permissions": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Category scoped actions derived from permissions.yaml.",
            "title": "Category Permissions",
            "type": "object"
          },
          "company_display_name": {
            "description": "Company display name (alias).",
            "title": "Company Display Name",
            "type": "string"
          },
          "company_id": {
            "description": "Authenticated company id.",
            "title": "Company Id",
            "type": "string"
          },
          "company_name": {
            "description": "Company display name.",
            "title": "Company Name",
            "type": "string"
          },
          "permission_actions": {
            "description": "Alias for permissions.",
            "items": {
              "type": "string"
            },
            "title": "Permission Actions",
            "type": "array"
          },
          "permissions": {
            "description": "Flat list of permission actions granted to the role.",
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "description": "Role identifier (ids from permissions.yaml).",
            "title": "Role",
            "type": "string"
          },
          "role_actions": {
            "description": "Role-level actions (from permissions.yaml role_actions).",
            "items": {
              "type": "string"
            },
            "title": "Role Actions",
            "type": "array"
          },
          "role_id": {
            "description": "Role identifier (alias).",
            "title": "Role Id",
            "type": "string"
          },
          "role_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Human-readable role name.",
            "title": "Role Name"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Authenticated user id.",
            "title": "User Id"
          }
        },
        "required": [
          "company_id",
          "company_name",
          "company_display_name",
          "role",
          "role_id"
        ],
        "title": "CurrentUser",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
