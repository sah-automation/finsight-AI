# FinSight AI local environment template.
# Copy to .env and export the values before running the local stack or tests.
# All values are safe placeholders. Never commit real credentials.
#
# The "test" profile matches docker-compose.test.yml and config/test.yaml.
# Use "development" only when you intend to run against the development profile.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Configuration profile loaded by finsight.core.config (development, test, staging, production)
ENVIRONMENT=test

# ---------------------------------------------------------------------------
# Vector database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
# Host and port of the local Postgres container
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
# Database name created by docker-compose.test.yml
VECTOR_DB_NAME=test
# Database user created by docker-compose.test.yml
VECTOR_DB_USER=test
# Database password for the local container (placeholder only)
VECTOR_DB_PASSWORD=test  # pragma: allowlist secret

# ---------------------------------------------------------------------------
# AWS / LocalStack
# ---------------------------------------------------------------------------
# Region used by S3, SQS, DynamoDB, and Cognito clients
AWS_REGION=us-east-1
# Region fallback used by the AWS SDK
AWS_DEFAULT_REGION=us-east-1
# Dummy LocalStack access key (not a real credential)
AWS_ACCESS_KEY_ID=test  # pragma: allowlist secret
# Dummy LocalStack secret key (not a real credential)
AWS_SECRET_ACCESS_KEY=test  # pragma: allowlist secret
# Point AWS SDK clients at LocalStack instead of real AWS
AWS_ENDPOINT_URL=http://localhost:4566

# ---------------------------------------------------------------------------
# Storage (S3 buckets created by infra/localstack/init.sh)
# ---------------------------------------------------------------------------
# Bucket for uploaded source documents
DOCUMENTS_BUCKET=documents
# Bucket for generated reports
REPORTS_BUCKET=reports
# Bucket for backups
BACKUPS_BUCKET=backups

# ---------------------------------------------------------------------------
# Queues (SQS queues created by infra/localstack/init.sh)
# ---------------------------------------------------------------------------
# Queue for document-ingestion jobs
INGESTION_QUEUE_URL=http://localhost:4566/000000000000/ingestion
# Queue for document-reprocessing jobs
REPROCESSING_QUEUE_URL=http://localhost:4566/000000000000/reprocessing
# Queue for report-generation jobs
REPORTS_QUEUE_URL=http://localhost:4566/000000000000/reports
# Dead-letter queue for failed jobs
DLQ_URL=http://localhost:4566/000000000000/dlq

# ---------------------------------------------------------------------------
# Caches and metering (DynamoDB tables created by infra/localstack/init.sh)
# ---------------------------------------------------------------------------
# DynamoDB table for cached answers
ANSWER_CACHE_TABLE=answer_cache
# DynamoDB table for cached role/permission decisions
ROLE_CACHE_TABLE=role_cache
# DynamoDB table for usage metering rows
METERING_TABLE=metering

# ---------------------------------------------------------------------------
# Authentication (Cognito)
# ---------------------------------------------------------------------------
# Cognito user-pool id (dummy value for LocalStack/unit tests)
COGNITO_USER_POOL_ID=us-east-1_testpool
# Cognito app-client id (dummy value for LocalStack/unit tests)
COGNITO_CLIENT_ID=testclient

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# OTLP collector endpoint started by docker-compose.test.yml
OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# Model providers (placeholders only; never put real keys in this file)
# ---------------------------------------------------------------------------
# Anthropic API key placeholder
ANTHROPIC_API_KEY=your-anthropic-key-here  # pragma: allowlist secret
# OpenAI API key placeholder
OPENAI_API_KEY=your-openai-key-here  # pragma: allowlist secret
